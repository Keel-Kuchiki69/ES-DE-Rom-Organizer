#!/usr/bin/env bash

set -Eeuo pipefail

########################################
# ES-DE ROM Organizer (v2 - corrigido)
#
# Principais correções em relação à versão original:
#   - Extração agora acontece na MESMA pasta do arquivo compactado
#     (antes ia sempre para a raiz, quebrando estruturas aninhadas).
#   - Suporte a arquivos aninhados (zip dentro de zip/pasta).
#   - Um arquivo corrompido não derruba o script inteiro; ele avisa
#     e segue para os próximos, sem apagar o arquivo com falha.
#   - Não sai mais do script se não achar compactados: continua
#     organizando ROMs que já estavam soltas nas pastas.
#   - Detecta e avisa sobre ROMs duplicadas em vez de ignorar em silêncio.
########################################

ARCHIVE_EXTENSIONS=(
    zip 7z rar tar
)
ARCHIVE_TAR_EXTENSIONS=(tar.gz tgz tar.xz tar.bz2)

ROM_EXTENSIONS=(
    iso bin cue chd
    rvz gcz wbfs
    cso pbp elf
    3ds cci cia
    nds
    gba gb gbc
    nes
    sfc smc
    n64 z64 v64
    xci nsp
    dkey
)

archives=0
removed_archives=0
failed_archives=0
roms=0
duplicates=0
removed_dirs=0

########################################
# Funções utilitárias
########################################

log() {
    printf "\033[1;34m==>\033[0m %s\n" "$1"
}

success() {
    printf "\033[1;32m✔\033[0m %s\n" "$1"
}

warning() {
    printf "\033[1;33m⚠\033[0m %s\n" "$1"
}

error() {
    printf "\033[1;31m✘\033[0m %s\n" "$1"
}

confirm() {
    local resp
    read -rp "$1 [Y/n] " resp
    resp="${resp,,}"
    [[ -z "$resp" || "$resp" == "y" || "$resp" == "yes" || "$resp" == "s" || "$resp" == "sim" ]]
}

# Monta uma expressão -iname para o find a partir de uma lista de extensões
build_find_expr() {
    local -n _ext_list=$1
    local -n _out_expr=$2
    _out_expr=()
    local ext
    for ext in "${_ext_list[@]}"; do
        _out_expr+=( -iname "*.${ext}" -o )
    done
    unset '_out_expr[${#_out_expr[@]}-1]'
}

########################################
# Verificar dependências
########################################

for cmd in unzip 7z unrar tar find mv rmdir; do
    command -v "$cmd" >/dev/null || {
        error "Dependência ausente: $cmd"
        exit 1
    }
done

########################################
# Extração (com suporte a arquivos aninhados)
########################################

build_find_expr ARCHIVE_EXTENSIONS archive_expr
build_find_expr ARCHIVE_TAR_EXTENSIONS archive_tar_expr

find_archives() {
    mapfile -d '' FILES < <(
        find . -type f \( "${archive_expr[@]}" -o "${archive_tar_expr[@]}" \) -print0
    )
}

# Extrai um único arquivo para dentro de "$2" (a pasta onde ele está).
# Retorna 0 em sucesso, 1 em falha — nunca aborta o script (set -e off aqui dentro).
extract_one() {
    local file="$1" dest_dir="$2"
    set +e
    case "${file,,}" in
        *.zip)      unzip -qq -o "$file" -d "$dest_dir" ;;
        *.7z)       7z x -y "$file" -o"$dest_dir" >/dev/null ;;
        *.rar)      unrar x -o+ "$file" "$dest_dir/" >/dev/null ;;
        *.tar)      tar xf "$file" -C "$dest_dir" ;;
        *.tar.gz|*.tgz)  tar xzf "$file" -C "$dest_dir" ;;
        *.tar.xz)   tar xJf "$file" -C "$dest_dir" ;;
        *.tar.bz2)  tar xjf "$file" -C "$dest_dir" ;;
        *) set -e; return 1 ;;
    esac
    local status=$?
    set -e
    return $status
}

find_archives

if [[ ${#FILES[@]} -eq 0 ]]; then
    warning "Nenhum arquivo compactado encontrado. Seguindo para organização de ROMs."
else
    log "Encontrados ${#FILES[@]} arquivo(s):"
    for f in "${FILES[@]}"; do
        printf "  • %s\n" "$(basename "$f")"
    done

    if confirm "Deseja extrair esses arquivos?"; then

        declare -A FAILED_FILES=()
        pass=0
        max_passes=15   # trava de segurança contra loop infinito

        while (( pass < max_passes )); do
            ((++pass))
            find_archives

            # Filtra arquivos que já falharam antes, pra não tentar de novo
            PENDING=()
            for f in "${FILES[@]}"; do
                [[ -n "${FAILED_FILES[$f]:-}" ]] || PENDING+=("$f")
            done

            [[ ${#PENDING[@]} -eq 0 ]] && break

            for file in "${PENDING[@]}"; do
                dest_dir="$(dirname "$file")"
                log "Extraindo $(basename "$file")"

                if extract_one "$file" "$dest_dir"; then
                    rm -f "$file"
                    ((++archives))
                    ((++removed_archives))
                else
                    error "Falha ao extrair $(basename "$file") — arquivo mantido, pulando."
                    FAILED_FILES["$file"]=1
                    ((++failed_archives))
                fi
            done
        done

        (( pass >= max_passes )) && warning "Limite de passadas de extração atingido — verifique se há loops de arquivos."
    else
        warning "Extração pulada a pedido do usuário."
    fi
fi

########################################
# Procurar e mover ROMs para a raiz
########################################

log "Organizando ROMs..."

build_find_expr ROM_EXTENSIONS rom_expr

mapfile -d '' ROM_FILES < <(
    find . -mindepth 1 -type f \( "${rom_expr[@]}" \) -print0
)

if [[ ${#ROM_FILES[@]} -eq 0 ]]; then
    warning "Nenhuma ROM encontrada."
else
    log "Encontradas ${#ROM_FILES[@]} ROM(s)."

    if confirm "Deseja mover essas ROMs para a pasta principal?"; then
        for file in "${ROM_FILES[@]}"; do

            # Já está na raiz? não faz nada (evita mv de um arquivo pra ele mesmo)
            if [[ "$(dirname "$file")" == "." ]]; then
                continue
            fi

            dest="./$(basename "$file")"

            if [[ ! -e "$dest" ]]; then
                mv "$file" .
                ((++roms))
            else
                warning "ROM duplicada, mantida na pasta original: $(basename "$file")"
                ((++duplicates))
            fi
        done
    else
        warning "Movimentação de ROMs pulada a pedido do usuário."
    fi
fi

########################################
# Remover pastas vazias
########################################

log "Removendo pastas vazias..."

while :; do
    mapfile -t EMPTY_DIRS < <(
        find . -depth -mindepth 1 -type d -empty
    )

    [[ ${#EMPTY_DIRS[@]} -eq 0 ]] && break

    for dir in "${EMPTY_DIRS[@]}"; do
        rmdir "$dir" 2>/dev/null || true
        ((++removed_dirs))
    done
done

########################################
# Resumo
########################################

echo
echo "=================================="
echo "          CONCLUÍDO"
echo "=================================="

printf "%-28s %5d\n" "Arquivos extraídos:"        "$archives"
printf "%-28s %5d\n" "Compactados removidos:"     "$removed_archives"
printf "%-28s %5d\n" "Falhas na extração:"        "$failed_archives"
printf "%-28s %5d\n" "ROMs organizadas:"          "$roms"
printf "%-28s %5d\n" "ROMs duplicadas (mantidas):" "$duplicates"
printf "%-28s %5d\n" "Pastas removidas:"          "$removed_dirs"

echo
success "Tudo pronto!"
